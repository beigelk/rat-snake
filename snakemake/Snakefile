def compiled_seurat_input(wc):
    return pop_outdir(wc.pop_name, "compile", "objects") + wc.pop_name + "_seurat.qs2"

def compile_inputs(wc):
    return {
        "target_obj":      population_seurat_obj(wc.pop_name),
        "cluster_results": population_cluster_outputs(wc.pop_name),
    }

def complete_compile_outputs(wildcards):
    return [
        pop_outdir(pop_name, "compile", "objects") + pop_name + "_seurat.qs2"
        for pop_name in COMPILE_TARGETS
    ]


# ============================================================
# FINDALLMARKERS + PLOTS CONFIG — nested per population
# ============================================================
def pop_assays(pop_name):
    return POPULATIONS[pop_name].get("findallmarkers", {}).get("assays", [])

def pop_threshold_sets(pop_name, assay):
    return POPULATIONS[pop_name]["findallmarkers"]["threshold_sets"][assay]

def pop_threshold_set_names(pop_name, assay):
    return list(pop_threshold_sets(pop_name, assay).keys())

def pop_threshold_values(pop_name, assay, threshold_set):
    return pop_threshold_sets(pop_name, assay)[threshold_set]

def pop_marker_set_specs(pop_name, assay):
    return POPULATIONS[pop_name].get("plots", {}).get("marker_sets", {}).get(assay, {})

def pop_marker_set_names(pop_name, assay):
    return list(pop_marker_set_specs(pop_name, assay).keys())

def pop_marker_set_spec(pop_name, assay, marker_set):
    return pop_marker_set_specs(pop_name, assay)[marker_set]

# Aggregated across all populations — only used for wildcard_constraints regexes.
# Actual valid combinations are enforced by the target-generator functions below,
# which only ever iterate real per-population entries.
ALL_ASSAYS = sorted({a for p in POPULATIONS for a in pop_assays(p)})
ALL_THRESHOLD_SET_NAMES = sorted({
    t for p in POPULATIONS for a in pop_assays(p) for t in pop_threshold_set_names(p, a)
})
ALL_MARKER_SET_NAMES = sorted({
    m for p in POPULATIONS for a in pop_assays(p) for m in pop_marker_set_names(p, a)
})


# ============================================================
# FINDALLMARKERS (raw tables, per pop/resolution/assay)
# ============================================================
def markers_raw_tsv_path(pop_name, resolution, assay):
    return (pop_outdir(pop_name, "findallmarkers", "tables/raw") +
        f"{PROJECT}__{pop_name}__{assay}_res.{format_res(resolution)}__markers_raw.tsv")

def get_marker_table_triples():
    return [
        (pop_name, resolution, assay)
        for pop_name in POPULATIONS
        for resolution in population_resolutions(pop_name)
        for assay in pop_assays(pop_name)
    ]

MARKER_TABLE_TRIPLES = get_marker_table_triples()

def findallmarkers_prefix(wc):
    return f"{PROJECT}__{wc.pop_name}__{wc.assay}_res.{wc.resolution}"

def complete_findallmarkers_outputs(wildcards):
    return [markers_raw_tsv_path(p, r, a) for p, r, a in MARKER_TABLE_TRIPLES]


# ============================================================
# FILTERMARKERS (filtered tables, per pop/resolution/assay/threshold_set)
# ============================================================
def markers_filtered_tsv_path(pop_name, resolution, assay, threshold_set):
    return (pop_outdir(pop_name, "findallmarkers", "tables/filtered") +
        f"{PROJECT}__{pop_name}__{assay}_res.{format_res(resolution)}__{threshold_set}__markers_filtered.tsv")

def get_filtered_marker_quads():
    return [
        (pop_name, resolution, assay, threshold_set)
        for pop_name, resolution, assay in MARKER_TABLE_TRIPLES
        for threshold_set in pop_threshold_set_names(pop_name, assay)
    ]

FILTERED_MARKER_QUADS = get_filtered_marker_quads()

def filtermarkers_prefix(wc):
    return f"{PROJECT}__{wc.pop_name}__{wc.assay}_res.{wc.resolution}_{wc.threshold_set}"

def complete_filtermarkers_outputs(wildcards):
    return [markers_filtered_tsv_path(p, r, a, t) for p, r, a, t in FILTERED_MARKER_QUADS]


