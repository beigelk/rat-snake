base_config = load_yaml("snakemake/config/base.yaml")

# ==============================================================================
# PROJECT CONFIGURATION
# ==============================================================================
PROJECT_NAME    = config['project_info']['name']
PROJECT_VERSION = config['project_info']['version']
PROJECT         = f"{PROJECT_NAME}_{PROJECT_VERSION}"

HOME = os.path.expanduser("~")
BASE = Path(workflow.basedir)
# or: HOME = str(Path.home())

TEMP_DIR = os.path.join(HOME, "temp", PROJECT)

DATASETS = list(config['datasets'].keys())
MODALITIES = ["gex", "csp", "vdj"]


# ==============================================================================
# RULE INDEX
# ==============================================================================
RULE_IDX = {}

for module, steps in base_config['modules'].items():
    for step in steps:
        sub = step.get('submodule')

        key = f"{module}/{sub}/{step['rule']}" if sub else f"{module}/{step['rule']}"

        rule_path = Path("workflow/rules") / module
        script_path = Path("workflow/scripts") / module

        if sub:
            rule_path /= sub
            script_path /= sub

        RULE_IDX[key] = {
            "module": module,
            "submodule": sub,
            "rule": step["rule"],
            "type": step["type"],
            "smk": str(rule_path / f"{step['rule']}.smk"),
            "r": (
                str(BASE / script_path / f"{step['rule']}.R")
                if step["type"] == "R"
                else None
            )
        }

RULES = [
    meta["smk"]
    for meta in RULE_IDX.values()
]


# ==============================================================================
# RESULTS INDEX
# ==============================================================================
RES_IDX = {
    key: {
        "outdir": f"projects/{PROJECT_NAME}/{PROJECT}/results/{meta['module']}/{meta['rule']}/",
        "module": meta["module"],
        "rule": meta["rule"],
    }
    for key, meta in RULE_IDX.items()
}

# ==============================================================================
# LOG INDEX
# ==============================================================================
LOG_IDX = {
    key: {
        "log": f"projects/{PROJECT_NAME}/{PROJECT}/logs/{meta['module']}/{meta['rule']}/"
    }
    for key, meta in RULE_IDX.items()
}


# ==============================================================================
# GET ORIGINAL SAMPLE LIST
# ==============================================================================
SAMPLES = {}
for dataset in config['datasets']:

    SAMPLES[dataset] = {}
    with open(config['datasets'][dataset]["sample_ids"]) as f:
        reader = csv.DictReader(f, delimiter="\t")
        for row in reader:
            # collect modality samples
            samples = {
                m: row[m].strip()
                for m in MODALITIES
                if row[m].strip()
            }
            # compute shared key
            sample_key = shared_tokens(samples.values())
            # store by key (IMPORTANT CHANGE)
            SAMPLES[dataset][sample_key] = samples


# ==============================================================================
# GET LIST OF SAMPLES THAT HAVE ALL THREE MODALITIES
# ==============================================================================
COMPLETE_SAMPLES = {
    ds: {
        sk: mods
        for sk, mods in samples.items()
        if all(m in mods for m in MODALITIES)
    }
    for ds, samples in SAMPLES.items()
}


