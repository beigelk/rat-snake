def load_yaml(path):
    with open(path) as f:
        return yaml.safe_load(f)

def shared_tokens(sample_names):

    split_names = [s.split("_") for s in sample_names]

    shared = []

    for token in split_names[0]:
        if all(token in parts for parts in split_names[1:]):
            if not token.startswith("S"):
                shared.append(token)

    return "_".join(shared)

def get_complete_samples():
    """Returns list of (dataset, sample_key) tuples for samples that are not skipped."""
    complete = []
    for dataset, samples in SAMPLES.items():
        for sample_key in samples:
            skipped_path = (
                RES_IDX['cellranger/configs']['outdir'] + f"{dataset}/tracking/{sample_key}_record.tsv"
            )
            checkpoints.make_configs.get(dataset=dataset, sample=sample_key)
            with open(skipped_path) as f:
                rows = list(csv.DictReader(f, delimiter="\t"))
            if not rows:
                complete.append((dataset, sample_key))
    return complete

def complete_cellranger_outputs(wildcards):
    complete = get_complete_samples()
    return expand(
        RES_IDX['cellranger/multi']['outdir'] + "touchfiles/{dataset}/{sample}_done.txt",
        zip,
        dataset=[d for d, s in complete],
        sample=[s for d, s in complete]
    )

def complete_soupx_outputs(wildcards):
    complete = get_complete_samples()
    datasets  = [d for d, s in complete]
    samples   = [s for d, s in complete]

    return (
        expand(
            RES_IDX['preprocess/rna/soupx']['outdir'] + "{dataset}/objects/soupx__{sample}.qs2",
            zip, dataset=datasets, sample=samples
        )
        + expand(
            RES_IDX['preprocess/rna/soupx']['outdir'] + "{dataset}/figures/soupx__{sample}.pdf",
            zip, dataset=datasets, sample=samples
        )
    )

def complete_doubletfinder_outputs(wildcards):
    complete = get_complete_samples()
    datasets  = [d for d, s in complete]
    samples   = [s for d, s in complete]

    base = RES_IDX['preprocess/rna/doubletfinder']['outdir']
    patterns = [
        "{dataset}/tables/{sample}_doublet_ids.txt",
        "{dataset}/figures/{sample}_doublet_pK.pdf",
        "{dataset}/figures/{sample}_doublet_QC.png",
    ]

    return [
        path
        for pattern in patterns
        for path in expand(base + pattern, zip, dataset=datasets, sample=samples)
    ]

def complete_dsb_outputs(wildcards):
    complete = get_complete_samples()
    datasets = [d for d, s in complete]
    samples  = [s for d, s in complete]

    base = RES_IDX['preprocess/adt/dsb']['outdir']
    patterns = [
        "{dataset}/objects/{sample}_dsb.qs2",
        "{dataset}/figures/{sample}_ADT_ScatterPlot.png",
        "{dataset}/figures/{sample}_ADT_Heatmap.png",
    ]

    return [
        path
        for pattern in patterns
        for path in expand(base + pattern, zip, dataset=datasets, sample=samples)
    ]

def complete_construct_outputs(wildcards):
    complete = get_complete_samples()
    datasets = [d for d, s in complete]
    samples  = [s for d, s in complete]

    base = RES_IDX['preprocess/multimodal/construct']['outdir']
    patterns = [
        "{dataset}/objects/{sample}_Seurat.qs2",
        "{dataset}/tables/{sample}_RNA_filtering_cutoffs.txt",
        "{dataset}/tables/{sample}_RNA_sig_pcs.txt",
        "{dataset}/figures/{sample}_Prefilt_QCPlots.pdf",
        "{dataset}/figures/{sample}_Prefilt_UMAPPlot.png",
        "{dataset}/figures/{sample}_Prefilt_VlnPlot.png",
        "{dataset}/figures/{sample}_Prefilt_FeatScatter.png",
        "{dataset}/figures/{sample}_Postfilt_QCPlots.pdf",
        "{dataset}/figures/{sample}_Postfilt_UMAPPlot.png",
        "{dataset}/figures/{sample}_Postfilt_VlnPlot.png",
        "{dataset}/figures/{sample}_Postfilt_FeatScatter.png",
    ]

    return [
        path
        for pattern in patterns
        for path in expand(base + pattern, zip, dataset=datasets, sample=samples)
    ]

