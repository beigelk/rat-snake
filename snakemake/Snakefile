def complete_cellranger_outputs(wildcards):
    complete = []
    for dataset, samples in SAMPLES.items():
        for sample_key in samples:
            skipped_path = (
                RES_IDX['cellranger/configs']['outdir'] + f"{dataset}/tracking/{sample_key}_record.tsv"
            )
            # trigger checkpoint - snakemake waits here until all make_configs jobs done
            checkpoints.make_configs.get(dataset=dataset, sample=sample_key)

            with open(skipped_path) as f:
                rows = list(csv.DictReader(f, delimiter="\t"))
            if not rows:
                complete.append((dataset, sample_key))

    # return expand(
    #     RES_IDX['cellranger/multi']['outdir'] + "{dataset}/{sample}/outs/per_sample_outs/{sample}/metrics_summary.csv",
    #     zip,
    #     dataset=[d for d, s in complete],
    #     sample=[s for d, s in complete]
    # )

    return expand(
        RES_IDX['cellranger/multi']['outdir'] + "touchfiles/{dataset}/{sample}_done.txt",
        zip,
        dataset=[d for d, s in complete],
        sample=[s for d, s in complete]
    )



base_config = load_yaml("snakemake/config/base.yaml")

RULE_IDX = {}

for module, steps in base_config["modules"].items():
    for step in steps:
        sub = step.get("submodule")

        key = f"{module}/{sub}/{step['rule']}" if sub else f"{module}/{step['rule']}"

        base_path = Path("workflow/rules") / module
        script_path = Path("snakemake/workflow/scripts") / module

        if sub:
            base_path /= sub
            script_path /= sub

        RULE_IDX[key] = {
            "module": module,
            "submodule": sub,
            "rule": step["rule"],
            "type": step["type"],
            "smk": str(base_path / f"{step['rule']}.smk"),
            "r": (
                str(script_path / f"{step['rule']}.R")
                if step["type"] == "R"
                else None
            )
        }

RULES = [
    meta["smk"]
    for meta in RULE_IDX.values()
]


