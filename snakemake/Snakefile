# -- HELPERS -------------------------------------------------
def expand_resolutions(res_block):
    """Expand a {from, to, by} dict into a list of resolution values."""
    return [round(r, 4) for r in np.arange(res_block["from"], res_block["to"] + res_block["by"]/2, res_block["by"])]

def clean_clusters_str(clusters):
    """Convert '0, 1, 2, 3, 8' or 4 or [0,1,2] -> '0-1-2-3-8' / '4' for safe filenames."""
    if isinstance(clusters, str):
        parts = [c.strip() for c in clusters.split(",")]
    elif isinstance(clusters, (int, float)):
        parts = [str(clusters)]
    else:
        # assume it's already a list/tuple
        parts = [str(c) for c in clusters]
    return "-".join(parts)

def parse_clusters_list(clusters):
    """Convert '0, 1, 2, 3, 8' or 4 or [0,1,2] -> [0, 1, 2, 3, 8] (list of ints)."""
    if isinstance(clusters, str):
        return [int(c.strip()) for c in clusters.split(",")]
    elif isinstance(clusters, (int, float)):
        return [int(clusters)]
    else:
        return [int(c) for c in clusters]

def format_res(value):
    """Format a resolution float for filenames: trims trailing zeros, no decimal if whole number.
    0.0 -> '0', 0.1 -> '0.1', 0.07 -> '0.07'"""
    value = round(float(value), 4)
    if value == int(value):
        return str(int(value))
    return f"{value:g}"
# ============================================================
# POPULATIONS
# ============================================================
POPULATIONS = {p["name"]: p for p in config['annotate']['populations']}

def is_root(pop_name):
    return "subset" not in POPULATIONS[pop_name]

def pop_outdir(pop_name, rule_key, subdir):
    """{RES_DIR}/annotate/populations/{pop_name}/{rule_key}/{subdir}/"""
    return f"{RES_DIR}/annotate/populations/{pop_name}/{rule_key}/{subdir}/"

def population_resolutions(pop_name):
    if not isinstance(pop_name, str):
        raise TypeError(f"population_resolutions() expected a str, got {type(pop_name).__name__}: {pop_name!r}")
    if pop_name not in POPULATIONS:
        raise KeyError(f"Unknown population {pop_name!r} — not in POPULATIONS keys: {list(POPULATIONS)}")
    res_specs = POPULATIONS[pop_name].get("resolutions") or {}
    resolutions = []
    for scheme_name, spec in res_specs.items():
        missing = {"from", "to", "by"} - spec.keys()
        if missing:
            raise KeyError(
                f"Population {pop_name!r}, resolution scheme {scheme_name!r} "
                f"is missing keys {missing} — got {spec}"
            )
        vals = np.arange(spec["from"], spec["to"] + spec["by"] / 2, spec["by"])
        resolutions.extend(round(float(v), 10) for v in vals)
    return sorted(set(resolutions))


# ============================================================
# CLUSTER / SUBSET
# ============================================================
def cluster_tsv_path(pop_name, resolution):
    graph_name = POPULATIONS[pop_name]["graph_name"]
    return pop_outdir(pop_name, "cluster", "tables") + f"cluster__{pop_name}__{graph_name}_res.{format_res(resolution)}.tsv"

def subset_obj_path(pop_name):
    graph_name = POPULATIONS[pop_name]["graph_name"]
    return pop_outdir(pop_name, "subset", "objects") + f"subset__{pop_name}__{graph_name}.qs2"

def population_seurat_obj(pop_name):
    """Object a population is/was clustered on: harmonized_seurat for roots,
    otherwise its own subset object."""
    return harmonized_seurat if is_root(pop_name) else subset_obj_path(pop_name)

def population_cluster_outputs(pop_name):
    return [cluster_tsv_path(pop_name, r) for r in population_resolutions(pop_name)]

def population_cluster_metadata(pop_name):
    graph_name = POPULATIONS[pop_name]["graph_name"]
    return [
        {"pop_name": pop_name, "graph_name": graph_name, "resolution": r, "file": cluster_tsv_path(pop_name, r)}
        for r in population_resolutions(pop_name)
    ]

def get_all_pop_resolution_pairs(include_roots=True):
    """(pop_name, resolution) pairs across all populations."""
    pairs = []
    for pop_name in POPULATIONS:
        if not include_roots and is_root(pop_name):
            continue
        for resolution in population_resolutions(pop_name):
            pairs.append((pop_name, resolution))
    return pairs


