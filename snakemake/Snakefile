def shared_tokens(sample_names):

    split_names = [s.split("_") for s in sample_names]

    shared = []

    for token in split_names[0]:
        if all(token in parts for parts in split_names[1:]):
            if not token.startswith("S"):
                shared.append(token)

    return "_".join(shared)


SAMPLES = {}

for dataset in config["datasets"]:

    SAMPLES[dataset] = {}

    with open(config["datasets"][dataset]["sample_ids"]) as f:

        reader = csv.DictReader(f, delimiter="\t")

        for row in reader:

            # collect modality samples
            samples = {
                m: row[m].strip()
                for m in MODALITIES
                if row[m].strip()
            }

            # compute shared key
            sample_key = shared_tokens(samples.values())

            # store by key (IMPORTANT CHANGE)
            SAMPLES[dataset][sample_key] = samples

COMPLETE_SAMPLES = {
    ds: {
        sk: mods
        for sk, mods in samples.items()
        if all(m in mods for m in MODALITIES)
    }
    for ds, samples in SAMPLES.items()
}

